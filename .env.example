# PVEHub-MCP environment configuration (copy to .env; never commit .env)
# Full reference: docs/CONFIGURATION.md

# --- MCP transport ---------------------------------------------------------
PVEHUB_TRANSPORT=http
PVEHUB_HOST=0.0.0.0
PVEHUB_PORT=8080
# Required for the http transport (any bind address); the server refuses to
# start without it. Generate with: openssl rand -hex 32 (never ship the
# placeholder).
PVEHUB_MCP_AUTH_TOKEN=
# Set false only for loopback development setups; the server logs a warning at
# startup and a non-loopback bind without a token is still refused.
PVEHUB_MCP_AUTH_REQUIRED=true
# Optional: per-client named tokens for audit attribution (D019, issue #21).
# Format: name:token,name2:token2 — token >= 16 chars; name 1-32 chars of
# [a-z0-9_-] (letter/digit first); "default" is reserved for
# PVEHUB_MCP_AUTH_TOKEN above. The http transport accepts at least one of
# PVEHUB_MCP_AUTH_TOKEN / PVEHUB_MCP_AUTH_TOKENS. Rotating one client's token
# no longer logs out the others.
PVEHUB_MCP_AUTH_TOKENS=
# Optional: bearer pass-through (D026, issue #30). With mcp_auth_mode set to
# "passthrough", the Authorization: Bearer value IS the requesting client's own
# PVE API token (user@realm!tokenid=<secret>) and is used as the credential for
# every PVE call of that request — the configured PVE service token is NOT used
# (fail-closed). Requirements: a PVE instance configured, PVEHUB_TRANSPORT=http,
# PVEHUB_MCP_AUTH_REQUIRED=true, and PVEHUB_MCP_TOKEN_VALIDATION_TTL >= 1. PBS
# tools are not registered in this mode (a PVE API token is not a PBS
# credential). The PVEHUB_MCP_AUTH_TOKEN(S) requirement is exempt in this mode.
#PVEHUB_MCP_AUTH_MODE=static
# Passthrough only: seconds a validated PVE API token (keyed by the full token
# identity, per PVE instance) is cached before re-validation against the PVE API.
# Minimum 1. A rotated secret is a different key and re-validates immediately.
#PVEHUB_MCP_TOKEN_VALIDATION_TTL=60
# Comma-separated Host header allowlist for DNS-rebinding protection.
# Empty: loopback binds are protected automatically; non-loopback binds need this.
PVEHUB_ALLOWED_HOSTS=
# Optional: trusted reverse proxies for client-IP audit attribution (D024, issue #25).
# Comma-separated CIDRs (or bare IPs; a bare IP becomes /32). Only when the socket
# peer is inside this set is X-Forwarded-For consulted for the client_ip field;
# otherwise the socket peer is logged. A malformed entry fails startup (fail-loud).
# Keep the set tight: 0.0.0.0/0 re-opens the forgery window.
PVEHUB_TRUSTED_PROXIES=
# true: /mcp and /ready return 403 (before authentication) for peers outside
# PVEHUB_TRUSTED_PROXIES. Requires a non-empty PVEHUB_TRUSTED_PROXIES.
# /health stays exempt (container healthchecks, D021).
PVEHUB_REQUIRE_TRUSTED_PROXY=false

# --- Proxmox VE (single instance; use config.yaml for multiple) -----------
PVEHUB_PVE_URL=https://pve.example.com:8006
PVEHUB_PVE_TOKEN_ID=pvehub@pve!mcp
PVEHUB_PVE_TOKEN_SECRET=00000000-0000-0000-0000-000000000000
PVEHUB_PVE_VERIFY=true
# Optional: path to a private CA bundle
# PVEHUB_PVE_CA_FILE=/config/pve-ca.pem
# Optional: SHA-256 certificate fingerprint pin (sha256:AB:CD:...)
# PVEHUB_PVE_FINGERPRINT=

# --- Proxmox Backup Server (single instance) ------------------------------
PVEHUB_PBS_URL=https://pbs.example.com:8007
PVEHUB_PBS_TOKEN_ID=pvehub@pbs!mcp
PVEHUB_PBS_TOKEN_SECRET=00000000-0000-0000-0000-000000000000
PVEHUB_PBS_VERIFY=true

# --- Policy ---------------------------------------------------------------
PVEHUB_POLICY_FILE=/config/policy.yaml
PVEHUB_READ_ONLY=false
# PVEHUB_DENY_TOOLS=pve_host_exec,pbs_host_exec
# PVEHUB_ALLOW_TOOLS=
# PVEHUB_DENY_CATEGORIES=destructive
# PVEHUB_REQUIRE_CONFIRM=destructive,exec
# PVEHUB_GENERIC_DENY_PATHS=/access/*,/nodes/*/vncshell
# PVEHUB_GENERIC_DENY_METHODS=DELETE

# --- Shell / SSH (opt-in) -------------------------------------------------
PVEHUB_EXEC_HOST=false
PVEHUB_EXEC_LXC=true
PVEHUB_EXEC_VM=true
PVEHUB_EXEC_PBS_HOST=false
PVEHUB_EXEC_ALLOWED_VMIDS=100-199
PVEHUB_SSH_USER=pvehub
PVEHUB_SSH_KEY_PATH=/ssh/id_ed25519
PVEHUB_SSH_KNOWN_HOSTS=/ssh/known_hosts
PVEHUB_SSH_STRICT_HOST_KEY_CHECKING=true
# Map PVE node names to SSH addresses (YAML recommended, see config.yaml)
# PVEHUB_SSH_NODES_JSON={"pve1":{"host":"10.0.0.11"}}
# PVEHUB_SSH_PBS_HOST=backup.example.com

# --- Limits / audit -------------------------------------------------------
PVEHUB_TASK_TIMEOUT_SECONDS=300
PVEHUB_EXEC_TIMEOUT_SECONDS=60
PVEHUB_MAX_OUTPUT_BYTES=65536
PVEHUB_AUDIT_LOG=/data/audit.jsonl
PVEHUB_AUDIT_INCLUDE_RESULTS=false
# Rotation: rotate the active audit file at this size (bytes) and keep this many
# rotated copies (audit.jsonl.1 .. .N); the oldest is dropped (D023, issue #19).
PVEHUB_AUDIT_MAX_BYTES=10485760
PVEHUB_AUDIT_KEEP=5
PVEHUB_CAPABILITIES_REFRESH_SECONDS=300
PVEHUB_CAPABILITIES_FAIL_OPEN=true
PVEHUB_LOG_LEVEL=INFO

# --- Memory layer (D025, issues #31-#39) ----------------------------------
# SQLite store next to the audit log; every key is optional.
PVEHUB_MEMORY_ENABLED=true
# Default: /data/memory.db (derived from PVEHUB_STATE_DIR)
# PVEHUB_MEMORY_DB=/data/memory.db
PVEHUB_MEMORY_ENRICH=true
PVEHUB_MEMORY_ENRICH_MAX_BYTES=2048
PVEHUB_MEMORY_ENRICH_MAX_NOTES=5
PVEHUB_MEMORY_NOTE_MAX_BYTES=8192
PVEHUB_MEMORY_RETENTION_DAYS=180
PVEHUB_MEMORY_EVENT_RETENTION_DAYS=90
PVEHUB_MEMORY_TOMBSTONE_DAYS=30
PVEHUB_MEMORY_CLEANUP_INTERVAL_SECONDS=3600
PVEHUB_MEMORY_MAX_NOTES=2000
