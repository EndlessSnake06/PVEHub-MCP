# PVEHub-MCP environment configuration (copy to .env; never commit .env)
# Full reference: docs/CONFIGURATION.md

# --- MCP transport ---------------------------------------------------------
PVEHUB_TRANSPORT=http
PVEHUB_HOST=0.0.0.0
PVEHUB_PORT=8080
# Required when binding to a non-loopback address; the server refuses to start
# without it. Generate with: openssl rand -hex 32 (never ship the placeholder).
PVEHUB_MCP_AUTH_TOKEN=
# Comma-separated Host header allowlist for DNS-rebinding protection.
# Empty: loopback binds are protected automatically; non-loopback binds need this.
PVEHUB_ALLOWED_HOSTS=

# --- Proxmox VE (single instance; use config.yaml for multiple) -----------
PVEHUB_PVE_URL=https://pve.example.com:8006
PVEHUB_PVE_TOKEN_ID=pvehub@pve!mcp
PVEHUB_PVE_TOKEN_SECRET=00000000-0000-0000-0000-000000000000
PVEHUB_PVE_VERIFY=true
# Optional: path to a private CA bundle
# PVEHUB_PVE_CA_FILE=/config/pve-ca.pem
# Optional: SHA-256 certificate fingerprint pin (sha256:AB:CD:...)
# PVEHUB_PVE_FINGERPRINT=

# --- Proxmox Backup Server (single instance) ------------------------------
PVEHUB_PBS_URL=https://pbs.example.com:8007
PVEHUB_PBS_TOKEN_ID=pvehub@pbs!mcp
PVEHUB_PBS_TOKEN_SECRET=00000000-0000-0000-0000-000000000000
PVEHUB_PBS_VERIFY=true

# --- Policy ---------------------------------------------------------------
PVEHUB_POLICY_FILE=/config/policy.yaml
PVEHUB_READ_ONLY=false
# PVEHUB_DENY_TOOLS=pve_host_exec,pbs_host_exec
# PVEHUB_ALLOW_TOOLS=
# PVEHUB_DENY_CATEGORIES=destructive
# PVEHUB_REQUIRE_CONFIRM=destructive,exec
# PVEHUB_GENERIC_DENY_PATHS=/access/*,/nodes/*/vncshell
# PVEHUB_GENERIC_DENY_METHODS=DELETE

# --- Shell / SSH (opt-in) -------------------------------------------------
PVEHUB_EXEC_HOST=false
PVEHUB_EXEC_LXC=true
PVEHUB_EXEC_VM=true
PVEHUB_EXEC_PBS_HOST=false
PVEHUB_EXEC_ALLOWED_VMIDS=100-199
PVEHUB_SSH_USER=pvehub
PVEHUB_SSH_KEY_PATH=/ssh/id_ed25519
PVEHUB_SSH_KNOWN_HOSTS=/ssh/known_hosts
PVEHUB_SSH_STRICT_HOST_KEY_CHECKING=true
# Map PVE node names to SSH addresses (YAML recommended, see config.yaml)
# PVEHUB_SSH_NODES_JSON={"pve1":{"host":"10.0.0.11"}}
# PVEHUB_SSH_PBS_HOST=backup.example.com

# --- Limits / audit -------------------------------------------------------
PVEHUB_TASK_TIMEOUT_SECONDS=300
PVEHUB_EXEC_TIMEOUT_SECONDS=60
PVEHUB_MAX_OUTPUT_BYTES=65536
PVEHUB_AUDIT_LOG=/data/audit.jsonl
PVEHUB_AUDIT_INCLUDE_RESULTS=false
PVEHUB_CAPABILITIES_REFRESH_SECONDS=300
PVEHUB_CAPABILITIES_FAIL_OPEN=true
PVEHUB_LOG_LEVEL=INFO
